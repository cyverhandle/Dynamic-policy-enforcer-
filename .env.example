# ============================================================================
# THREAT INTELLIGENCE PLATFORM - ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and update values for your environment
# Never commit .env files to version control
# ============================================================================

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# MongoDB Connection Settings
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB=threat_intel
MONGODB_USER=tip_admin
MONGODB_PASSWORD=CHANGE_THIS_TO_SECURE_PASSWORD

# MongoDB Options
MONGODB_MAX_POOL_SIZE=100
MONGODB_MIN_POOL_SIZE=10
MONGODB_MAX_IDLE_TIME_MS=30000
MONGO_CONNECT_TIMEOUT_MS=5000
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=CHANGE_THIS_TO_SECURE_PASSWORD
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# ============================================================================
# THREAT INTELLIGENCE FEEDS - API KEYS
# ============================================================================

# VirusTotal API (Required - Free tier available at virustotal.com)
# Get your key: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=b349a7b0af8881e9d49799fc2bbe1e354026ef54455e36d4c61bf440a4fb3d3a

# AlienVault OTX API (Recommended - Free at otx.alienvault.com)
# Get your key: https://otx.alienvault.com/api
ALIENVAULT_API_KEY=cd3c82f79f8b4f16649326d7e734f72f67402ab224bf83203cc4801c87da9a9b

# AbuseIPDB API (Optional - Free tier available)
# Get your key: https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=a75982048a3613a7773a9d53141bfb3483ae0ae82eca962a901e5ee67406c071450248b8580de66e


# IBM X-Force Exchange (Optional - Requires registration)
# Get your key: https://exchange.xforce.ibmcloud.com/
IBM_XFORCE_API_KEY=
IBM_XFORCE_API_PASSWORD=

# Shodan API (Optional - Premium feature)
# Get your key: https://account.shodan.io/
SHODAN_API_KEY=

# GreyNoise API (Optional - Free tier available)
# Get your key: https://greynoise.io/account/api-keys
GREYNOISE_API_KEY=

# Recorded Future API (Optional - Enterprise)
RECORDED_FUTURE_API_KEY=

# MISP Integration (Optional - For sharing intel)
MISP_URL=https://your-misp-instance.com
MISP_API_KEY=
MISP_VERIFY_SSL=true

# ============================================================================
# THREAT FEED CONFIGURATIONS
# ============================================================================

# Enable/Disable specific feeds (true/false)
FEED_VIRUSTOTAL_ENABLED=true
FEED_ALIENVAULT_ENABLED=true
FEED_ABUSEIPDB_ENABLED=false
FEED_FEODO_TRACKER_ENABLED=true
FEED_TOR_EXIT_NODES_ENABLED=true
FEED_SPAMHAUS_ENABLED=true
FEED_EMERGING_THREATS_ENABLED=true
FEED_CISCO_TALOS_ENABLED=false

# Feed collection intervals (seconds)
FEED_VIRUSTOTAL_INTERVAL=3600
FEED_ALIENVAULT_INTERVAL=1800
FEED_FEODO_TRACKER_INTERVAL=3600
FEED_TOR_INTERVAL=7200
FEED_SPAMHAUS_INTERVAL=43200

# Risk scores for feeds (0-100)
FEED_VIRUSTOTAL_RISK_BASE=85
FEED_ALIENVAULT_RISK_BASE=75
FEED_FEODO_TRACKER_RISK_BASE=90
FEED_TOR_RISK_BASE=60
FEED_SPAMHAUS_RISK_BASE=80

# ============================================================================
# DYNAMIC POLICY ENFORCEMENT
# ============================================================================

# Firewall Configuration
# Options: iptables, nftables, windows
FIREWALL_TYPE=iptables

# Firewall Chain (INPUT, FORWARD, OUTPUT)
FIREWALL_CHAIN=INPUT

# Auto-blocking Settings
AUTO_BLOCK_ENABLED=true

# Risk threshold for auto-blocking (0-100, default 70)
HIGH_RISK_THRESHOLD=70

# Block duration in seconds (default 86400 = 24 hours)
BLOCK_DURATION_SECONDS=86400

# Maximum number of concurrent block rules
MAX_BLOCK_RULES=10000

# Block list refresh interval (seconds)
BLOCK_REFRESH_INTERVAL=300

# Enable logging for blocked connections
LOG_BLOCKED_CONNECTIONS=true

# Rate limiting for block actions (prevent DoS)
BLOCK_RATE_LIMIT=10  # Max blocks per minute
BLOCK_BURST_LIMIT=20

# Whitelist settings
WHITELIST_FILE=/etc/tip/whitelist.txt
ENABLE_WHITELIST=true

# ============================================================================
# SIEM INTEGRATION (ELK Stack)
# ============================================================================

# Elasticsearch Configuration
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_SCHEME=http
ELASTICSEARCH_USER=
ELASTICSEARCH_PASSWORD=

# Index settings
ELASTICSEARCH_INDEX_PREFIX=threat-intel
ELASTICSEARCH_INDEX_ROTATION=daily  # daily, weekly, monthly

# Logstash Configuration
LOGSTASH_HOST=localhost
LOGSTASH_PORT=5000
LOGSTASH_USE_TCP=true

# Kibana Configuration
KIBANA_URL=http://localhost:5601
KIBANA_USER=
KIBANA_PASSWORD=

# SIEM Sync Settings
SIEM_SYNC_ENABLED=true
SIEM_SYNC_INTERVAL=60  # seconds
SIEM_BATCH_SIZE=1000

# ============================================================================
# ALERTING & NOTIFICATIONS
# ============================================================================

# Slack Integration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=#security-alerts
SLACK_USERNAME=ThreatIntelBot
SLACK_ICON_EMOJI=:robot_face:

# Email Configuration
EMAIL_ENABLED=false
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=alerts@your-bank.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=threat-intel@your-bank.com
ALERT_RECIPIENTS=security-team@bank.com,soc-analyst@bank.com

# PagerDuty Integration
PAGERDUTY_ENABLED=false
PAGERDUTY_API_KEY=
PAGERDUTY_SERVICE_ID=

# Microsoft Teams Integration
MS_TEAMS_WEBHOOK_URL=

# Alert Thresholds (risk scores)
ALERT_CRITICAL_THRESHOLD=90
ALERT_HIGH_THRESHOLD=70
ALERT_MEDIUM_THRESHOLD=40

# Alert Rate Limiting (seconds between same alert)
ALERT_RATE_LIMIT_SECONDS=300

# ============================================================================
# RISK SCORING ENGINE
# ============================================================================

# Risk Score Weights (must sum to 1.0)
RISK_WEIGHT_FEED_REPUTATION=0.20
RISK_WEIGHT_AGE_FACTOR=0.15
RISK_WEIGHT_SOURCE_COUNT=0.15
RISK_WEIGHT_HISTORICAL=0.20
RISK_WEIGHT_INDICATOR_TYPE=0.15
RISK_WEIGHT_GEO_LOCATION=0.15

# High-risk country codes (comma-separated)
HIGH_RISK_COUNTRIES=RU,CN,IR,KP,SY,VE

# Medium-risk country codes
MEDIUM_RISK_COUNTRIES=UA,BY,PK,AF,IQ

# Feed reputation scores
FEED_REPUTATION_VIRUSTOTAL=95
FEED_REPUTATION_ALIENVAULT=85
FEED_REPUTATION_FEODO_TRACKER=90
FEED_REPUTATION_ABUSEIPDB=88
FEED_REPUTATION_SPAMHAUS=85
FEED_REPUTATION_CISCO_TALOS=80
FEED_REPUTATION_EMERGING_THREATS=75

# ============================================================================
# API SERVER CONFIGURATION
# ============================================================================

# API Settings
API_HOST=0.0.0.0
API_PORT=5001
API_DEBUG=false
API_WORKERS=4
API_THREADS=2

# API Authentication
API_AUTH_ENABLED=false
API_JWT_SECRET=change_this_to_random_string_at_least_32_chars
API_JWT_EXPIRATION_HOURS=24
API_API_KEY_ENABLED=true
API_API_KEYS=key1:analyst,key2:admin  # format: key:role

# Rate Limiting
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_PER_MINUTE=100
API_RATE_LIMIT_BURST=150

# CORS Configuration
API_CORS_ORIGINS=http://localhost:3000,https://dashboard.bank.com

# SSL/TLS (for production)
API_SSL_ENABLED=false
API_SSL_CERT=/etc/ssl/certs/tip.crt
API_SSL_KEY=/etc/ssl/private/tip.key

# ============================================================================
# COMPLIANCE & AUDITING (PCI-DSS, SOC2, ISO27001)
# ============================================================================

# Audit Settings
AUDIT_LOG_ENABLED=true
AUDIT_RETENTION_DAYS=365  # PCI-DSS requires 1 year
AUDIT_LOG_CAPPED_SIZE=104857600  # 100MB for capped collection

# Enable PCI-DSS compliance mode
ENABLE_PCI_DSS_MODE=true

# Enable immutable audit logs (append-only)
AUDIT_IMMUTABLE_LOGS=true

# Compliance logging
LOG_ALL_ACCESS=true
LOG_AUTHENTICATION_ATTEMPTS=true
LOG_CONFIGURATION_CHANGES=true

# GDPR specific
REDACT_PERSONAL_DATA=true
PII_FIELDS=email,name,phone

# ============================================================================
# PERFORMANCE TUNING
# ============================================================================

# Collection Settings
COLLECTION_INTERVAL_SECONDS=1800
MAX_CONCURRENT_FEEDS=5
FEED_TIMEOUT_SECONDS=30
BATCH_SIZE=1000

# Database Performance
MONGODB_MAX_POOL_SIZE=100
MONGODB_MIN_POOL_SIZE=10
MONGODB_OPERATION_TIMEOUT=5000

# Redis Cache Settings
ENABLE_REDIS_CACHE=true
CACHE_TTL_SECONDS=300
CACHE_MAX_ITEMS=10000

# Processing Threads
WORKER_THREADS=4
BACKGROUND_TASKS_THREADS=2

# Queue Settings
MAX_QUEUE_SIZE=10000
QUEUE_PROCESSING_BATCH=100

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log Levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
API_LOG_LEVEL=INFO
ENFORCER_LOG_LEVEL=INFO
AGGREGATOR_LOG_LEVEL=INFO

# Log File Settings
LOG_DIR=/var/log/tip
LOG_RETENTION_DAYS=30
LOG_MAX_SIZE_MB=100
LOG_ROTATION_COUNT=10

# Log Formats
LOG_FORMAT=json  # json, text
LOG_INCLUDE_TIMESTAMP=true
LOG_INCLUDE_PID=true

# Remote Logging
SYSLOG_ENABLED=false
SYSLOG_HOST=localhost
SYSLOG_PORT=514
SYSLOG_PROTOCOL=udp  # udp, tcp

# ============================================================================
# BACKUP & RECOVERY
# ============================================================================

# Backup Settings
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_DIR=/opt/tip_backups

# Database Backup
BACKUP_MONGODB=true
BACKUP_REDIS=true

# Configuration Backup
BACKUP_CONFIG=true
BACKUP_FIREWALL_RULES=true

# ============================================================================
# MONITORING & METRICS
# ============================================================================

# Prometheus Metrics
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
PROMETHEUS_PATH=/metrics

# Health Check
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=60
HEALTH_CHECK_ENDPOINT=/api/health

# Sentry for Error Tracking
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# New Relic
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=ThreatIntelPlatform

# ============================================================================
# DEVELOPMENT / TESTING SETTINGS
# ============================================================================

# Environment: development, staging, production
ENVIRONMENT=production

# Debug Mode (never enable in production)
DEBUG=false

# Test Mode (disables some safety features)
TEST_MODE=false

# Mock external APIs (for testing)
MOCK_EXTERNAL_APIS=false

# Bypass SSL verification (development only)
VERIFY_SSL=true

# ============================================================================
# EMERGENCY CONTACTS
# ============================================================================

# Security team contact (used in critical alerts)
SECURITY_TEAM_EMAIL=security@bank.com
SECURITY_TEAM_PHONE=+1-555-555-5555
SECURITY_ON_CALL_PAGER=security-oncall@bank.com

# ============================================================================
# ADVANCED FEATURES
# ============================================================================

# Machine Learning for Anomaly Detection
ML_ENABLED=false
ML_MODEL_PATH=/opt/tip/models/
ML_INFERENCE_INTERVAL=300

# Threat Hunting
THREAT_HUNTING_ENABLED=true
THREAT_HUNTING_SCHEDULE="0 */6 * * *"  # Every 6 hours

# IOC Sharing (STIX/TAXII)
STIX_TAXII_ENABLED=false
TAXII_DISCOVERY_URL=
TAXII_COLLECTION_ID=
TAXII_USERNAME=
TAXII_PASSWORD=

# MITRE ATT&CK Mapping
MITRE_ATTACK_ENABLED=true
MITRE_ATTACK_VERSION=14.1

# GeoIP Enrichment
GEOIP_ENABLED=true
GEOIP_DATABASE=/usr/share/GeoIP/GeoLite2-City.mmdb

# DNS Sinkhole Integration
DNS_SINKHOLE_ENABLED=false
DNS_SINKHOLE_SERVER=10.0.0.53
DNS_SINKHOLE_ZONE=threat.local

# ============================================================================
# DEPRECATED / LEGACY SETTINGS
# ============================================================================

# Old API endpoints (to be removed)
ENABLE_LEGACY_API=false

# ============================================================================
# NOTES:
# ============================================================================
# 1. Always use strong passwords (minimum 32 characters)
# 2. Store API keys securely - use a secrets manager in production
# 3. Never commit .env files to version control
# 4. Rotate credentials regularly (every 90 days)
# 5. Use different API keys for different environments
# 6. For production, use a secrets management system like HashiCorp Vault
# ============================================================================
